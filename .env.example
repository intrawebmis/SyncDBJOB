# ===== การเชื่อมต่อ MySQL (Remote Server) =====
DB_HOST=192.168.1.10
DB_PORT=3306
DB_USER=sync_user
DB_PASSWORD=your_password_here
DB_NAME=production_db

# เปิดใช้ SSL สำหรับ MySQL Cloud / RDS (true/false)
DB_SSL=false
DB_CONNECT_TIMEOUT_MS=10000
DB_POOL_SIZE=10

# ชนิดเซิร์ฟเวอร์ฐานข้อมูล (กำหนด syntax ของ ON DUPLICATE KEY UPDATE)
#   auto    = ตรวจจับอัตโนมัติจาก VERSION() (ค่าเริ่มต้น แนะนำ)
#   mysql   = MySQL 8.0.19+ ใช้ alias `AS new`
#   mariadb = MariaDB ใช้ VALUES() — MariaDB ไม่รองรับ alias `AS new`
DB_DIALECT=auto

# ===== Web UI =====
APP_HOST=0.0.0.0
APP_PORT=3000

# ฐานพาธที่แอปถูก mount ไว้ (เว้นว่าง = อยู่ที่ root)
# ใช้กรณีติดตั้งใต้ subfolder เช่น https://ebcitrade.com/SyncJOB/ → APP_BASE_PATH=/SyncJOB
# (พอร์ตจะใช้ค่า PORT ที่ host ให้มาอัตโนมัติ ถ้าไม่ได้ตั้ง APP_PORT เอง)
APP_BASE_PATH=

# ===== ระบบล็อกอิน (Login) =====
# เปิด/ปิดระบบล็อกอิน (true = ต้องล็อกอินก่อนใช้งาน) — ค่าเริ่มต้นคือ true
# ⚠️ ปิดไว้ได้เฉพาะตอนทดลองบนเครื่อง ไม่ควรเปิดสู่อินเทอร์เน็ต
APP_AUTH_ENABLED=true

# ตารางที่เก็บผู้ใช้ (ต้องมีคอลัมน์ USERNAME, PASSWORD_HASH, FULL_NAME, ROLE, USER_ACTIVE)
AUTH_USERS_TABLE=newfin_users

# คีย์สำหรับเซ็น cookie — เว้นว่างไว้จะสร้างและบันทึกที่ storage/.session-secret ให้อัตโนมัติ
APP_SESSION_SECRET=

# อายุ session (ชั่วโมง)
APP_SESSION_TTL_HOURS=12

# จำนวนครั้งที่ล็อกอินผิดพลาดได้ ก่อนถูกล็อกชั่วคราว (ต่อชื่อผู้ใช้ + IP)
APP_LOGIN_MAX_ATTEMPTS=10

# เวลาล็อกบัญชีชั่วคราว (นาที)
APP_LOGIN_LOCK_MINUTES=15

# วางหลัง nginx / reverse proxy ให้เปิด (ใช้ X-Forwarded-For, X-Forwarded-Proto)
APP_TRUST_PROXY=false

# ===== พฤติกรรมการ Sync =====
# skip = ข้ามแถวที่ผิดพลาดแล้วทำแถวถัดไป (ค่าเริ่มต้น)
# abort = ย้อนกลับทั้งหมดเมื่อพบข้อผิดพลาด
SYNC_ON_ERROR=skip

# จำนวนแถวสูงสุดที่รวมเป็นคำสั่ง INSERT เดียว (1 = ทีละแถว ได้จำนวน insert/update แม่นยำ)
SYNC_BATCH_SIZE=1

# สร้างตารางประวัติการทำงาน sync_job_log อัตโนมัติหรือไม่
CREATE_JOB_LOG_TABLE=true

# โฟลเดอร์เก็บไฟล์ที่อัปโหลดและ mapping ที่บันทึกจาก Web UI
STORAGE_DIR=storage

# ===== Logging =====
# debug | info | warn | error
LOG_LEVEL=info
