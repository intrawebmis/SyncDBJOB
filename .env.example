# ===== การเชื่อมต่อ MySQL (Remote Server) =====
DB_HOST=192.168.1.10
DB_PORT=3306
DB_USER=sync_user
DB_PASSWORD=your_password_here
DB_NAME=production_db

# เปิดใช้ SSL สำหรับ MySQL Cloud / RDS (true/false)
DB_SSL=false
DB_CONNECT_TIMEOUT_MS=10000
DB_POOL_SIZE=10

# ===== Web UI =====
APP_HOST=0.0.0.0
APP_PORT=3000

# ===== พฤติกรรมการ Sync =====
# skip = ข้ามแถวที่ผิดพลาดแล้วทำแถวถัดไป (ค่าเริ่มต้น)
# abort = ย้อนกลับทั้งหมดเมื่อพบข้อผิดพลาด
SYNC_ON_ERROR=skip

# จำนวนแถวสูงสุดที่รวมเป็นคำสั่ง INSERT เดียว (1 = ทีละแถว ได้จำนวน insert/update แม่นยำ)
SYNC_BATCH_SIZE=1

# สร้างตารางประวัติการทำงาน sync_job_log อัตโนมัติหรือไม่
CREATE_JOB_LOG_TABLE=true

# โฟลเดอร์เก็บไฟล์ที่อัปโหลดและ mapping ที่บันทึกจาก Web UI
STORAGE_DIR=storage

# ===== Logging =====
# debug | info | warn | error
LOG_LEVEL=info
