# บังคับให้เก็บ line ending เป็น LF ใน repo และแปลงเป็น CRLF เมื่อ checkout บน Windows
* text=auto eol=lf

# ไฟล์สคริปต์ Windows ให้ใช้ CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# ไฟล์ binary ห้ามแปลง
*.xlsx binary
*.xlsm binary
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.pdf binary
